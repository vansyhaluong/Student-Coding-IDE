+
+static std::shared_ptr<pty_baton> RequireJobBaton(const Napi::CallbackInfo& info) {
+  if (info.Length() != 1 || !info[0].IsString()) {
+    throw Napi::Error::New(info.Env(), "Expected an opaque Windows Job token");
+  }
+  auto baton = get_job_baton(info[0].As<Napi::String>().Utf8Value());
+  if (!baton) {
+    throw Napi::Error::New(info.Env(), "Unknown or stale Windows Job token");
+  }
+  return baton;
+}
+
+static JOBOBJECT_BASIC_ACCOUNTING_INFORMATION QueryJobAccounting(
+    const Napi::CallbackInfo& info,
+    HANDLE job) {
+  JOBOBJECT_BASIC_ACCOUNTING_INFORMATION accounting{};
+  if (!QueryInformationJobObject(job,
+                                 JobObjectBasicAccountingInformation,
+                                 &accounting,
+                                 sizeof(accounting),
+                                 nullptr)) {
+    throw errorWithCode(info, "QueryInformationJobObject failed");
+  }
+  return accounting;
+}
+
+static Napi::Value PtyJobActiveProcessCount(const Napi::CallbackInfo& info) {
+  auto baton = RequireJobBaton(info);
+  const auto accounting = QueryJobAccounting(info, baton->hJob);
+  return Napi::Number::New(info.Env(), accounting.ActiveProcesses);
+}
+
+static Napi::Value PtyTerminateJob(const Napi::CallbackInfo& info) {
+  auto baton = RequireJobBaton(info);
+  const auto accounting = QueryJobAccounting(info, baton->hJob);
+  if (accounting.ActiveProcesses > 0 && !TerminateJobObject(baton->hJob, 1)) {
+    throw errorWithCode(info, "TerminateJobObject failed");
+  }
+  return info.Env().Undefined();
+}
+
+static Napi::Value PtyReleaseJob(const Napi::CallbackInfo& info) {
+  auto baton = RequireJobBaton(info);
+  const auto accounting = QueryJobAccounting(info, baton->hJob);
+  if (accounting.ActiveProcesses != 0) {
+    throw Napi::Error::New(info.Env(), "Cannot release a non-empty Windows Job");
+  }
+
+  if (baton->hpc != nullptr) {
+    HANDLE hLibrary = LoadConptyDll(info, baton->useConptyDll);
+    PFNCLOSEPSEUDOCONSOLE const closePseudoConsole =
+        (PFNCLOSEPSEUDOCONSOLE)GetProcAddress(
+            (HMODULE)hLibrary,
+            baton->useConptyDll ? "ConptyClosePseudoConsole" : "ClosePseudoConsole");
+    if (closePseudoConsole) closePseudoConsole(baton->hpc);
+    baton->hpc = nullptr;
+  }
+
+  // KILL_ON_JOB_CLOSE is deliberately not configured. The handle is released
+  // only after explicit termination and an observed empty Job.
+  if (!CloseHandle(baton->hJob)) {
+    throw errorWithCode(info, "CloseHandle for Windows Job failed");
+  }
+  baton->hJob = nullptr;
+
+  if (!remove_pty_baton(baton->id)) {
+    throw Napi::Error::New(info.Env(), "Windows Job ownership was already released");
+  }
+  return info.Env().Undefined();
+}
