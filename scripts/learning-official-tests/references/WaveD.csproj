<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <!-- Fixed trusted inputs even if an editor creates adjacent obj/Debug files.
         BaseIntermediateOutputPath lives elsewhere; never rely on default globs. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
<Compile Include="WaveDProgram.cs" />
<Compile Include="ch8-02/Solution.cs" />
<Compile Include="ch8-03/Solution.cs" />
<Compile Include="ch8-04/Solution.cs" />
<Compile Include="ch8-05/Solution.cs" />
<Compile Include="ch8-06/Solution.cs" />
<Compile Include="ch8-07/Solution.cs" />
<Compile Include="ch8-09/Solution.cs" />
</ItemGroup>
</Project>
