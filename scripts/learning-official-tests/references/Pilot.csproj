<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <UseSharedCompilation>false</UseSharedCompilation>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <!-- Fixed trusted inputs even if an editor creates adjacent obj/Debug files.
         BaseIntermediateOutputPath lives elsewhere; never rely on default globs. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ch2-04/Solution.cs" />
    <Compile Include="ch3-04/Solution.cs" />
    <Compile Include="ch4-09/Solution.cs" />
    <Compile Include="ch5-03/Solution.cs" />
    <Compile Include="ch5-07/Solution.cs" />
    <Compile Include="ch7-01/Solution.cs" />
    <Compile Include="ch7-05/Solution.cs" />
    <Compile Include="ch8-01/Solution.cs" />
    <Compile Include="ch8-08/Solution.cs" />
  </ItemGroup>
</Project>
